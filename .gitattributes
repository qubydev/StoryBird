# Shell scripts must keep LF endings. A CRLF checkout makes the shebang
# `#!/usr/bin/env bash\r`, which fails with "bad interpreter" on macOS/Linux.
*.sh text eol=lf

# PowerShell is fine either way, but keep it consistent with Windows tooling.
*.ps1 text eol=crlf

# Let git normalise the rest by content.
* text=auto
