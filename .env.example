# Copy to .env and fill in. setup.ps1 / setup.sh create this for you.
# Never commit .env — it is gitignored for a reason.

# ─── Voiceover (required for auto-create) ────────────────────────────────────
# https://famespeak.online — used for text to speech.
FAMESPEAK_API_KEY=

# ─── Language model (required) ───────────────────────────────────────────────
# Which provider writes scene groupings, character lists and image prompts.
# One of: openrouter | groq
PROMPT_PROVIDER=openrouter

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
# Extra Groq keys are used round-robin and retried on rate limits.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# ─── Optional tuning ─────────────────────────────────────────────────────────
# OPENROUTER_TIMEOUT_SECONDS=20
# FAMESPEAK_POLL_INTERVAL_SECONDS=1.5
# FAMESPEAK_POLL_TIMEOUT_SECONDS=300
# FAMESPEAK_VOICE_CACHE_SECONDS=900

# Where the persistent Google Flow sign-in profile is stored.
# FLOW_PROFILE_DIR=

# Local ChatGPT wrapper, only if you run one.
# CHATGPT_WRAPPER_URL=http://127.0.0.1:8001
# CHATGPT_WRAPPER_TIMEOUT_SECONDS=120

# Not required: utils/redis_client.py is not imported by the app.
# REDIS_URL=
